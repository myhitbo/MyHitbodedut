App/Info.plist
App/*.entitlements
Widgets/Info.plist
Widgets/*.entitlements
Surveillance/Info.plist
Surveillance/*.entitlements
Bouclier/Info.plist
Bouclier/*.entitlements
BouclierAction/Info.plist
BouclierAction/*.entitlements
# fastlane
fastlane/report.xml
fastlane/README.md
build/
# Engendrés par tools/export_contenu/export.py (PORTAGE.md § 4.2) : seuls le manifeste et les
# chaînes propres à iOS sont versionnés.
Ressources/*
!Ressources/MANIFESTE.json
!Ressources/Chaines/
Ressources/Chaines/*
!Ressources/Chaines/ios.xcstrings
!Ressources/Chaines/InfoPlist.xcstrings
