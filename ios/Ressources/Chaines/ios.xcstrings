        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הגישה הוסרה על ידי iOS"
          }
        }
      }
    },
    "ios_bientot": {
      "comment": "Propre à iOS (PORTAGE.md § 4.2), à relire par le propriétaire : sous le titre d'un onglet dont l'écran n'est pas encore porté.",
