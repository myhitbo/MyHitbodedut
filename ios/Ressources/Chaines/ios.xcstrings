    "reglages_autorisation_temps_ecran_pourquoi": {
      "comment": "Réglages, carte des autorisations : pourquoi Temps d'écran. Écrans d'iOS, phase 3 : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour poser l'écran « Je suis avec Hachem » sur les applications choisies, le matin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To show the “I am with Hashem” screen on the apps you choose, in the morning."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "כדי להציג את המסך „אני עם ה׳“ על היישומים שבחרת, בבוקר."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para mostrar la pantalla «Estoy con Hashem» en las apps elegidas, por la mañana."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "باش تظهر شاشة «أنا مع ربّي» على التطبيقات اللي تختارها، الصباح."
          }
        }
      }
    },
    "reglages_fenetre_courte": {
      "comment": "Barrière, écrans et extensions d'iOS (tâches 27 et 28, PORTAGE.md § 2.1) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La plage horaire doit durer au moins 15 minutes : iOS n’en surveille pas de plus courte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The hours must last at least 15 minutes: iOS does not watch a shorter span."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "השעות צריכות להימשך 15 דקות לפחות: iOS לא עוקבת אחרי פרק זמן קצר יותר."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El horario debe durar al menos 15 minutos: iOS no vigila uno más corto."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الفترة لازمها تدوم 15 دقيقة على الأقل: iOS ما يراقبش فترة أقصر."
          }
        }
      }
    },
    "temps_ecran_divulgation_pas_maintenant": {
      "comment": "Barrière, écrans et extensions d'iOS (tâches 27 et 28, PORTAGE.md § 2.1) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pas maintenant"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Not now"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לא עכשיו"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ahora no"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "موش توّة"
          }
        }
      }
    },
    "temps_ecran_divulgation_texte": {
      "comment": "Barrière, écrans et extensions d'iOS (tâches 27 et 28, PORTAGE.md § 2.1) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce qui est fait : pendant la plage horaire que vous avez fixée, tant que la pratique du jour n’est pas faite, et pendant toute hitbodedout en cours, iOS pose un écran sur les applications et les sites que vous choisirez dans le sélecteur d’Apple.\n\nCe qui n’est pas fait : MyHitbodedut ne voit ni le nom de vos applications, ni ce que vous ouvrez, ni le temps que vous y passez. iOS ne lui donne que des jetons illisibles.\n\nRien n’est enregistré, envoyé ni partagé : tout reste sur ce téléphone.\n\nPour couper la barrière à tout moment : Réglages, interrupteur « Je suis avec Hachem ». Vous pouvez aussi retirer cet accès dans les Réglages d’iOS, Temps d’écran."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "What is done: during the hours you set, as long as the day’s practice is not done, and during any hitbodedut in progress, iOS places a screen over the apps and websites you choose in Apple’s picker.\n\nWhat is not done: MyHitbodedut sees neither the names of your apps, nor what you open, nor how long you spend there. iOS only gives it unreadable tokens.\n\nNothing is recorded, sent or shared: everything stays on this phone.\n\nTo turn the barrier off at any time: Settings, “I am with Hashem” switch. You can also remove this access in iOS Settings, Screen Time."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מה נעשה: בשעות שקבעתם, כל עוד התרגול של היום לא נעשה, ובמהלך כל התבודדות פעילה, iOS מציבה מסך על האפליקציות והאתרים שתבחרו בבוחר של Apple.\n\nמה לא נעשה: MyHitbodedut לא רואה את שמות האפליקציות שלכם, לא מה שאתם פותחים ולא כמה זמן אתם שם. iOS נותנת לה רק אסימונים בלתי קריאים.\n\nדבר לא נשמר, נשלח או משותף: הכול נשאר בטלפון הזה.\n\nכדי לכבות את המחסום בכל רגע: הגדרות, המתג „אני עם השם”. אפשר גם להסיר את הגישה הזו בהגדרות של iOS, זמן מסך."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lo que se hace: durante el horario que fijaste, mientras la práctica del día no esté hecha, y durante cualquier hitbodedut en curso, iOS pone una pantalla sobre las aplicaciones y los sitios web que elijas en el selector de Apple.\n\nLo que no se hace: MyHitbodedut no ve el nombre de tus aplicaciones, ni lo que abres, ni el tiempo que pasas en ellas. iOS solo le da fichas ilegibles.\n\nNada se guarda, se envía ni se comparte: todo se queda en este teléfono.\n\nPara apagar la barrera en cualquier momento: Ajustes, interruptor «Estoy con Hashem». También puedes retirar este acceso en los Ajustes de iOS, Tiempo de uso."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شنوّة يتعمل: في الفترة اللي حدّدتها، ما دامت الممارسة متاع النهار ما تعملتش، وفي كل هتبوديدوت ماشية، iOS يحط شاشة على التطبيقات والمواقع اللي باش تختارهم في المختار متاع Apple.\n\nشنوّة ما يتعملش: MyHitbodedut ما يشوفش أسامي تطبيقاتك، ولا شنوّة تحلّ، ولا قدّاش تقعد فيهم. iOS ما يعطيه كان رموز ما تتقراش.\n\nحتى شي ما يتسجّل، ما يتبعث وما يتشارك: كل شي يقعد في التليفون هذا.\n\nباش تطفّي الحاجز وقت ما تحب: الإعدادات، المفتاح «أنا مع هاشم». تنجم زادة تنحّي النفاذ هذا من إعدادات iOS، مدة استخدام الشاشة."
          }
        }
      }
    },
    "temps_ecran_divulgation_titre": {
