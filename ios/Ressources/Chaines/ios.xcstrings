        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Add or remove a bookmark"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הוספה או הסרה של סימנייה"
          }
        }
      }
    },
    "reglages_autorisation_temps_ecran": {
      "comment": "Chaîne propre à iOS, lue par le Traducteur de l'app (App/MyHitbodedutApp.swift fusionne ce catalogue au sien) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Temps d’écran"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Screen Time"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "זמן מסך"
          }
        }
      }
    },
    "reglages_autorisation_temps_ecran_pourquoi": {
      "comment": "Chaîne propre à iOS, lue par le Traducteur de l'app (App/MyHitbodedutApp.swift fusionne ce catalogue au sien) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour garder fermées les applications choisies tant que la hitbodedout n’est pas faite. Rien n’est enregistré ni envoyé."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To keep the apps you chose closed until your hitbodedut is done. Nothing is recorded or sent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "כדי להשאיר סגורות את האפליקציות שבחרת עד שההתבודדות נעשית. דבר אינו נשמר או נשלח."
          }
        }
      }
    },
    "reglages_concentration_hint": {
      "comment": "Chaîne propre à iOS, lue par le Traducteur de l'app (App/MyHitbodedutApp.swift fusionne ce catalogue au sien) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS ne laisse pas une application couper les notifications. Créez un mode de concentration « Hitbodedout » qui s’active quand MyHitbodedut est ouverte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS does not let an app silence notifications. Create a “Hitbodedut” Focus that turns on when MyHitbodedut is open."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS אינו מאפשר לאפליקציה להשתיק התראות. צרו מצב ריכוז „התבודדות” שמופעל כאשר MyHitbodedut פתוחה."
          }
        }
      }
    },
    "reglages_divulgation_continuer": {
      "comment": "Chaîne propre à iOS, lue par le Traducteur de l'app (App/MyHitbodedutApp.swift fusionne ce catalogue au sien) : à relire par le propriétaire.",
      "extractionState": "manual",
