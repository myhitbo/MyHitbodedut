{
  "sourceLanguage": "fr",
  "strings": {
    "action_ok": {
      "comment": "« OK » d'une saisie (android.R.string.ok, une chaîne du système sur Android). Écrans d'iOS, phase 3 : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "OK"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "OK"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "אישור"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aceptar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "باهي"
          }
        }
      }
    },
    "apps_ios_android": {
      "comment": "Barrière, écrans et extensions d'iOS (tâches 27 et 28, PORTAGE.md § 2.1) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sur Android, vous reteniez : %1$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "On Android, you held back: %1$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "באנדרואיד חסמתם: %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En Android, retenías: %1$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "في أندرويد، كنت تسكّر: %1$@"
          }
        }
      }
    },
    "apps_ios_categories": {
      "comment": "Barrière, écrans et extensions d'iOS (tâches 27 et 28, PORTAGE.md § 2.1) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Catégories : %1$lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Categories: %1$lld"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "קטגוריות: %1$lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Categorías: %1$lld"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الفئات: %1$lld"
          }
        }
      }
    },
    "apps_ios_explication": {
      "comment": "Barrière, écrans et extensions d'iOS (tâches 27 et 28, PORTAGE.md § 2.1) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le sélecteur d’Apple propose les applications, des catégories entières et des sites. MyHitbodedut ne voit ni leurs noms ni ce que vous en faites : iOS les garde pour lui."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apple’s picker offers apps, whole categories and websites. MyHitbodedut sees neither their names nor what you do with them: iOS keeps them to itself."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הבוחר של Apple מציע אפליקציות, קטגוריות שלמות ואתרים. MyHitbodedut לא רואה את שמותיהם ולא מה שאתם עושים בהם: iOS שומרת אותם לעצמה."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El selector de Apple ofrece aplicaciones, categorías enteras y sitios web. MyHitbodedut no ve sus nombres ni lo que haces con ellos: iOS los guarda para sí."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المختار متاع Apple يقترح التطبيقات، فئات كاملة والمواقع. MyHitbodedut ما يشوفش أساميهم ولا شنوّة تعمل بيهم: iOS يخبّيهم عندو."
          }
        }
      }
    },
    "apps_ios_limite": {
      "comment": "Barrière, écrans et extensions d'iOS (tâches 27 et 28, PORTAGE.md § 2.1) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Plus de %1$lld applications : iOS n’en retient pas davantage, et ne le dit pas. Choisissez plutôt une catégorie entière."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "More than %1$lld apps: iOS holds back no more than that, and does not say so. Choose a whole category instead."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יותר מ-%1$lld אפליקציות: iOS לא חוסמת יותר מזה, ולא אומרת זאת. בחרו במקום זאת קטגוריה שלמה."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Más de %1$lld aplicaciones: iOS no retiene más, y no lo dice. Elige mejor una categoría entera."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أكثر من %1$lld تطبيق: iOS ما يسكّرش أكثر، وما يقولهاش. اختار خير فئة كاملة."
          }
        }
      }
    },
    "apps_ios_sites": {
      "comment": "Barrière, écrans et extensions d'iOS (tâches 27 et 28, PORTAGE.md § 2.1) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sites : %1$lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Websites: %1$lld"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "אתרים: %1$lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sitios web: %1$lld"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المواقع: %1$lld"
          }
        }
      }
    },
    "bouclier_apercu_explication": {
      "comment": "Barrière, écrans et extensions d'iOS (tâches 27 et 28, PORTAGE.md § 2.1) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voici l’écran qu’iOS posera sur les applications choisies. Il ne porte qu’une image, un titre, un texte et deux boutons ; touchez une variante pour la voir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This is the screen iOS will place over the chosen apps. It can only hold an image, a title, a text and two buttons; tap a variant to see it."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "זה המסך ש-iOS תציב על האפליקציות שנבחרו. יש בו רק תמונה, כותרת, טקסט ושני כפתורים; געו באחת הגרסאות כדי לראות אותה."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta es la pantalla que iOS pondrá sobre las aplicaciones elegidas. Solo lleva una imagen, un título, un texto y dos botones; toca una variante para verla."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هاذي الشاشة اللي iOS باش يحطها على التطبيقات اللي اخترتها. فيها كان تصويرة، عنوان، نص وزوز بوتونات؛ انقر على نسخة باش تشوفها."
          }
        }
      }
    },
    "bouclier_apercu_titre": {
      "comment": "Barrière, écrans et extensions d'iOS (tâches 27 et 28, PORTAGE.md § 2.1) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le bouclier"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The shield"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "המגן"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El escudo"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الدرع"
          }
        }
      }
    },
    "bouclier_autre_reponse": {
      "comment": "Barrière, état propre à iOS (PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autre réponse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Other answer"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "תשובה אחרת"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otra respuesta"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جواب آخر"
          }
        }
      }
    },
    "bouclier_essai": {
      "comment": "Barrière, écrans et extensions d'iOS (tâches 27 et 28, PORTAGE.md § 2.1) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faire un essai de deux minutes"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Try it for two minutes"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לנסות במשך שתי דקות"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hacer una prueba de dos minutos"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اعمل تجربة دقيقتين"
          }
        }
      }
    },
    "bouclier_essai_echec": {
      "comment": "Barrière, écrans et extensions d'iOS (tâches 27 et 28, PORTAGE.md § 2.1) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’essai n’a pas pu commencer. Rouvrez l’app et réessayez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The trial could not start. Reopen the app and try again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הניסיון לא הצליח להתחיל. פתחו שוב את האפליקציה ונסו שוב."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La prueba no pudo empezar. Vuelve a abrir la app e inténtalo de nuevo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "التجربة ما نجمتش تبدا. عاود حلّ التطبيق وجرّب مرة أخرى."
          }
        }
      }
    },
    "bouclier_essai_en_cours": {
      "comment": "Barrière, écrans et extensions d'iOS (tâches 27 et 28, PORTAGE.md § 2.1) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Essai en cours jusqu’à %1$@ : ouvrez une des applications choisies."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trial running until %1$@: open one of the chosen apps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הניסיון פעיל עד %1$@: פתחו אחת מהאפליקציות שנבחרו."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prueba en curso hasta las %1$@: abre una de las aplicaciones elegidas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "التجربة ماشية حتى %1$@: حلّ واحد من التطبيقات اللي اخترتها."
          }
        }
      }
    },
    "bouclier_essai_explication": {
      "comment": "Barrière, écrans et extensions d'iOS (tâches 27 et 28, PORTAGE.md § 2.1) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pendant deux minutes, à n’importe quelle heure, les applications choisies montreront le vrai bouclier, « APERÇU, AUCUN EFFET ». Ouvrez-en une pour le voir, puis touchez « Fermer l’aperçu »."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "For two minutes, at any time of day, the chosen apps will show the real shield, “PREVIEW, NO EFFECT”. Open one to see it, then tap “Close the preview”."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "במשך שתי דקות, בכל שעה, האפליקציות שנבחרו יציגו את המגן האמיתי, „תצוגה מקדימה, ללא השפעה”. פתחו אחת מהן כדי לראות אותו, ואז געו ב„לסגור את התצוגה”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Durante dos minutos, a cualquier hora, las aplicaciones elegidas mostrarán el escudo real, «VISTA PREVIA, SIN EFECTO». Abre una para verlo y luego toca «Cerrar la vista previa»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "مدة دقيقتين، في أي وقت، التطبيقات اللي اخترتها باش تورّي الدرع الحقيقي، «معاينة، بلا تأثير». حلّ واحد منهم باش تشوفو، ومن بعد انقر على «سكّر المعاينة»."
          }
        }
      }
    },
    "bouclier_essai_lance": {
      "comment": "Barrière, écrans et extensions d'iOS (tâches 27 et 28, PORTAGE.md § 2.1) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Essai lancé : ouvrez une des applications choisies."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trial started: open one of the chosen apps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הניסיון התחיל: פתחו אחת מהאפליקציות שנבחרו."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prueba iniciada: abre una de las aplicaciones elegidas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "التجربة بدات: حلّ واحد من التطبيقات اللي اخترتها."
          }
        }
      }
    },
    "bouclier_essai_sans_acces": {
      "comment": "Barrière, écrans et extensions d'iOS (tâches 27 et 28, PORTAGE.md § 2.1) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorisez d’abord Temps d’écran, dans la carte des autorisations des réglages."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "First allow Screen Time, in the permissions card of the settings."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "קודם אשרו את זמן מסך, בכרטיס ההרשאות שבהגדרות."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Primero autoriza Tiempo de uso, en la tarjeta de permisos de los ajustes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قبل كل شي سمّح لمدة استخدام الشاشة، في بطاقة الأذونات متاع الإعدادات."
          }
        }
      }
    },
    "bouclier_notification_commencer": {
      "comment": "Barrière, état propre à iOS (PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire.",
