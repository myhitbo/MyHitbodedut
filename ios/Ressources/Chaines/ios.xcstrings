    },
    "gate_mismatch_detail": {
      "comment": "Barrière, état propre à iOS (PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le bouclier ne suivait pas la règle du moment. L’app l’a remis d’accord et l’a noté au journal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The shield was not following the current rule. The app has put it right and noted it in the log."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "המגן לא פעל לפי הכלל הנוכחי. האפליקציה תיקנה אותו ורשמה זאת ביומן."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El escudo no seguía la regla del momento. La app lo ha corregido y lo ha anotado en el registro."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الدرع ما كانش يتبّع القاعدة متاع الوقت هذا. التطبيق صلّحو وكتبها في السجل."
          }
        }
      }
    },
