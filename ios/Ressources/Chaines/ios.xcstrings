    "concentration_etape_app": {
      "comment": "Chaîne propre à iOS, lue par le Traducteur de l'app (App/MyHitbodedutApp.swift fusionne ce catalogue au sien) : à relire par le propriétaire. Aide à la concentration (ConcentrationModele, PORTAGE.md § 2.2.6). Étape 5.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choose MyHitbodedut. The Focus will turn on every time you open the app."
          }
        },
        "fr": {
          "stringUnit": {
