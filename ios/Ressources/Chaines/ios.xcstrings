      }
    },
    "concentration_etape_autoriser": {
      "comment": "Chaîne propre à iOS, lue par le Traducteur de l'app (App/MyHitbodedutApp.swift fusionne ce catalogue au sien) : à relire par le propriétaire. Aide à la concentration (ConcentrationModele, PORTAGE.md § 2.2.6). Étape 3.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choose the people and apps that can still reach you. Add MyHitbodedut to the allowed apps so the end-of-session notification comes through."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisissez les personnes et les apps qui pourront encore vous joindre. Ajoutez MyHitbodedut aux apps autorisées : la notification de fin de séance passera."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "בחרו את האנשים והאפליקציות שעדיין יוכלו להגיע אליכם. הוסיפו את MyHitbodedut לאפליקציות המורשות, כדי שההתראה על סיום ההתבודדות תגיע."
          }
        }
      }
    },
    "concentration_etape_creer": {
      "comment": "Chaîne propre à iOS, lue par le Traducteur de l'app (App/MyHitbodedutApp.swift fusionne ce catalogue au sien) : à relire par le propriétaire. Aide à la concentration (ConcentrationModele, PORTAGE.md § 2.2.6). Étape 2.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tap + at the top, then Custom. Name the Focus “Hitbodedut”, choose a color and an icon, then tap Next."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez + en haut, puis Personnalisé. Nommez le mode « Hitbodedout », choisissez une couleur et une icône, puis touchez Suivant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הקישו על + למעלה, ואז על „מותאם אישית”. קראו למצב „התבודדות”, בחרו צבע וסמל, ואז הקישו על „הבא”."
          }
        }
      }
    },
    "concentration_etape_ouvrir": {
      "comment": "Chaîne propre à iOS, lue par le Traducteur de l'app (App/MyHitbodedutApp.swift fusionne ce catalogue au sien) : à relire par le propriétaire. Aide à la concentration (ConcentrationModele, PORTAGE.md § 2.2.6). Étape 1.",
