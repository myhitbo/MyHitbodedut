    "gate_monitor_silent_detail": {
      "comment": "Barrière, état propre à iOS (PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS n’a pas réveillé la surveillance depuis hier. Ouvrir l’app le matin la relance."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS has not woken the schedule since yesterday. Opening the app in the morning restarts it."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS לא העירה את המעקב מאתמול. פתיחת האפליקציה בבוקר מפעילה אותו מחדש."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS no ha despertado la vigilancia desde ayer. Abrir la app por la mañana la reactiva."
