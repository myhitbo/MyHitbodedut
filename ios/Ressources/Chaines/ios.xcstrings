{
  "sourceLanguage": "fr",
  "strings": {
    "action_ok": {
      "comment": "Chaîne propre à iOS, lue par le Traducteur de l'app (App/MyHitbodedutApp.swift fusionne ce catalogue au sien) : à relire par le propriétaire. Bouton OK de la durée réglable (accueil, ajout de temps, séance).",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "OK"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "OK"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "אישור"
          }
        }
      }
    },
    "bouclier_autre_reponse": {
      "comment": "Barrière, état propre à iOS (PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autre réponse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Other answer"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "תשובה אחרת"
          }
        }
      }
    },
    "bouclier_notification_commencer": {
      "comment": "Barrière, état propre à iOS (PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez pour commencer votre hitbodedout"
          }
