{
  "sourceLanguage": "fr",
  "strings": {
    "action_ok": {
      "comment": "Chaîne propre à iOS, lue par le Traducteur de l'app (App/MyHitbodedutApp.swift fusionne ce catalogue au sien) : à relire par le propriétaire. Bouton OK de la durée réglable (accueil, ajout de temps, séance).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "OK"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "OK"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "אישור"
          }
        }
      }
    },
    "apercu_bouclier_essai_bouton": {
      "comment": "Chaîne propre à iOS, aperçu du bouclier de la barrière (ApercuBouclierModele ; PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire. Bouton qui lance l’essai réel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Try it (2 min)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Faire un essai (2 min)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לנסות (2 דק׳)"
          }
        }
      }
    },
    "apercu_bouclier_essai_detail": {
      "comment": "Chaîne propre à iOS, aperçu du bouclier de la barrière (ApercuBouclierModele ; PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire. Explication de l’essai réel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "For two minutes, at any time of day, the chosen apps show the real shield, marked “PREVIEW, NO EFFECT”. Open one of them to see it, then tap “Close the preview”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pendant deux minutes, à n’importe quelle heure, les applications choisies montrent le vrai bouclier, marqué « APERÇU, AUCUN EFFET ». Ouvrez-en une pour le voir, puis touchez « Fermer l’aperçu »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "במשך שתי דקות, בכל שעה, האפליקציות שנבחרו מציגות את המגן האמיתי, עם הכיתוב „תצוגה מקדימה, ללא השפעה”. פתחו אחת מהן כדי לראות אותו, ואז הקישו על „לסגור את התצוגה”."
          }
        }
      }
    },
    "apercu_bouclier_essai_en_cours": {
      "comment": "Chaîne propre à iOS, aperçu du bouclier de la barrière (ApercuBouclierModele ; PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire. Après le lancement de l’essai ; %1$@ : l’heure de fin (« 14:02 »).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trial running until %1$@: open one of the chosen apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Essai lancé jusqu’à %1$@ : ouvrez une application choisie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הניסיון פעיל עד %1$@: פתחו אחת מהאפליקציות שנבחרו."
          }
        }
      }
    },
    "apercu_bouclier_essai_impossible": {
      "comment": "Chaîne propre à iOS, aperçu du bouclier de la barrière (ApercuBouclierModele ; PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire. L’essai n’a pu commencer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The trial could not start. It needs Screen Time access, granted to the app by Apple, and at least one chosen app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’essai n’a pas pu commencer. Il demande l’accès à Temps d’écran, accordé par Apple à l’app, et au moins une application choisie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לא ניתן היה להתחיל את הניסיון. הוא דורש גישה לזמן מסך, שאפל מעניקה לאפליקציה, ולפחות אפליקציה אחת שנבחרה."
          }
        }
      }
    },
    "apercu_bouclier_essai_titre": {
      "comment": "Chaîne propre à iOS, aperçu du bouclier de la barrière (ApercuBouclierModele ; PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire. Titre de la carte de l’essai réel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The real trial"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’essai réel"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הניסיון האמיתי"
          }
        }
      }
    },
    "apercu_bouclier_intro": {
      "comment": "Chaîne propre à iOS, aperçu du bouclier de la barrière (ApercuBouclierModele ; PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire. Introduction de l’écran.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This is the shield iOS will show on the chosen apps, in its three versions. iOS draws it itself: on the iPhone, the layout may differ slightly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Voici le bouclier tel qu’iOS le montrera sur les applications choisies, dans ses trois visages. iOS le dessine lui-même : sur l’iPhone, la mise en page peut différer un peu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "זה המגן ש־iOS יציג על האפליקציות שנבחרו, בשלוש צורותיו. iOS מצייר אותו בעצמו: באייפון הפריסה עשויה להיות מעט שונה."
          }
        }
      }
    },
    "apercu_bouclier_visage_essai": {
      "comment": "Chaîne propre à iOS, aperçu du bouclier de la barrière (ApercuBouclierModele ; PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire. Visage du bouclier pendant l’essai réel (sélecteur).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trial"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Essai"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ניסיון"
          }
        }
      }
    },
    "apercu_bouclier_visage_invite": {
      "comment": "Chaîne propre à iOS, aperçu du bouclier de la barrière (ApercuBouclierModele ; PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire. Visage du bouclier quand rien n’est fait aujourd’hui (sélecteur).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Not done yet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rien de fait"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "טרם נעשה"
          }
        }
      }
    },
    "apercu_bouclier_visage_seance": {
      "comment": "Chaîne propre à iOS, aperçu du bouclier de la barrière (ApercuBouclierModele ; PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire. Visage du bouclier pendant une séance (sélecteur).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Session running"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Séance en cours"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מפגש פעיל"
          }
        }
      }
    },
    "applications_android_aide": {
      "comment": "Chaîne propre à iOS, choix des applications de la barrière (ApplicationsModele ; PORTAGE.md § 2.1.3, § 3.7) : à relire par le propriétaire. L’aide-mémoire de la liste venue d’Android (blocked_apps d’une sauvegarde importée) ; %1$@ : les noms de paquets, séparés par des virgules.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "On Android, you held back: %1$@. These choices do not move from one phone to another: choose these apps again here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sur Android, vous reteniez : %1$@. Ces choix ne passent pas d’un téléphone à l’autre : choisissez de nouveau ces applications ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "באנדרואיד חסמתם: %1$@. הבחירות האלה אינן עוברות מטלפון לטלפון: בחרו שוב את האפליקציות האלה כאן."
          }
        }
      }
    },
    "applications_autorisation_a_demander": {
      "comment": "Chaîne propre à iOS, choix des applications de la barrière (ApplicationsModele ; PORTAGE.md § 2.1.3, § 3.7) : à relire par le propriétaire. Temps d’écran jamais demandé.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "To block apps, MyHitbodedut needs access to Screen Time. iOS will ask you for it (Face ID or passcode). Nothing is recorded or sent."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour bloquer des applications, MyHitbodedut a besoin de l’accès à Temps d’écran. iOS vous le demandera (Face ID ou code). Rien n’est enregistré ni envoyé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "כדי לחסום אפליקציות, MyHitbodedut צריכה גישה לזמן מסך. iOS יבקש את אישורכם (Face ID או קוד). דבר אינו נשמר ואינו נשלח."
          }
        }
      }
    },
    "applications_autorisation_accordee": {
      "comment": "Chaîne propre à iOS, choix des applications de la barrière (ApplicationsModele ; PORTAGE.md § 2.1.3, § 3.7) : à relire par le propriétaire. Temps d’écran autorisé.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Screen Time access is granted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accès à Temps d’écran est accordé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הגישה לזמן מסך אושרה."
          }
        }
      }
    },
    "applications_autorisation_attente": {
      "comment": "Chaîne propre à iOS, choix des applications de la barrière (ApplicationsModele ; PORTAGE.md § 2.1.3, § 3.7) : à relire par le propriétaire. La feuille de Temps d’écran est ouverte.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Waiting for your answer to iOS…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En attente de votre réponse à iOS…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ממתין לתשובתך ל־iOS…"
          }
        }
      }
    },
    "applications_autorisation_echec": {
      "comment": "Chaîne propre à iOS, choix des applications de la barrière (ApplicationsModele ; PORTAGE.md § 2.1.3, § 3.7) : à relire par le propriétaire. La demande a échoué : sans l’entitlement Family Controls accordé par Apple (décision D3), iOS refuse.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS refused Screen Time access. This version of MyHitbodedut has probably not yet received Apple’s “Family Controls” permission: without it, no app can be blocked. Also check that the iPhone has a passcode."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS a refusé l’accès à Temps d’écran. Cette version de MyHitbodedut n’a sans doute pas encore reçu d’Apple l’autorisation « Family Controls » : sans elle, aucune application ne peut être bloquée. Vérifiez aussi qu’un code protège l’iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS סירב לגשת לזמן מסך. גרסה זו של MyHitbodedut כנראה עדיין לא קיבלה מ־Apple את ההרשאה „Family Controls”: בלעדיה לא ניתן לחסום אף אפליקציה. בדקו גם שהאייפון מוגן בקוד."
          }
        }
      }
    },
    "applications_autorisation_refusee": {
      "comment": "Chaîne propre à iOS, choix des applications de la barrière (ApplicationsModele ; PORTAGE.md § 2.1.3, § 3.7) : à relire par le propriétaire. Temps d’écran refusé : expliquer, proposer les Réglages.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Screen Time access was declined: nothing can be blocked. You can ask again, or allow it in the iPhone’s Settings, under Screen Time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L’accès à Temps d’écran a été refusé : rien ne peut être bloqué. Vous pouvez reposer la question, ou rendre l’accès dans les Réglages de l’iPhone, rubrique Temps d’écran."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הגישה לזמן מסך נדחתה: לא ניתן לחסום דבר. אפשר לשאול שוב, או לאפשר את הגישה בהגדרות האייפון, תחת זמן מסך."
          }
        }
      }
    },
    "applications_autorisation_restreinte": {
      "comment": "Chaîne propre à iOS, choix des applications de la barrière (ApplicationsModele ; PORTAGE.md § 2.1.3, § 3.7) : à relire par le propriétaire. FamilyControlsError.restricted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Screen Time is restricted on this iPhone (parental controls or device management): MyHitbodedut cannot use it, and nothing will be blocked."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Temps d’écran est restreint sur cet iPhone (contrôle parental ou gestion de l’appareil) : MyHitbodedut ne peut pas s’en servir, et rien ne sera bloqué."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "זמן מסך מוגבל באייפון הזה (בקרת הורים או ניהול מכשיר): MyHitbodedut אינה יכולה להשתמש בו, ודבר לא ייחסם."
          }
        }
      }
    },
    "applications_categories": {
      "comment": "Chaîne propre à iOS, choix des applications de la barrière (ApplicationsModele ; PORTAGE.md § 2.1.3, § 3.7) : à relire par le propriétaire. Le nombre de catégories entières retenues (pas de pluriel : la forme évite les variations).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Whole categories: %1$lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Catégories entières : %1$lld"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "קטגוריות שלמות: %1$lld"
          }
        }
      }
    },
    "applications_echec_ecriture": {
      "comment": "Chaîne propre à iOS, choix des applications de la barrière (ApplicationsModele ; PORTAGE.md § 2.1.3, § 3.7) : à relire par le propriétaire. L’écriture de la sélection dans le groupe d’apps a échoué.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The selection could not be saved on the iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La sélection n’a pas pu être enregistrée sur l’iPhone."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לא ניתן היה לשמור את הבחירה באייפון."
          }
        }
      }
    },
    "applications_indication": {
      "comment": "Chaîne propre à iOS, choix des applications de la barrière (ApplicationsModele ; PORTAGE.md § 2.1.3, § 3.7) : à relire par le propriétaire. Sous le titre de l’écran.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The iOS picker offers apps, whole categories and websites. MyHitbodedut sees neither their names nor what you open: iOS hands them over as anonymous tokens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le sélecteur d’iOS propose les applications, des catégories entières et des sites web. MyHitbodedut ne voit ni leurs noms ni ce que vous ouvrez : iOS les lui donne en jetons anonymes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הבורר של iOS מציע אפליקציות, קטגוריות שלמות ואתרים. MyHitbodedut אינה רואה את שמותיהם ולא את מה שאתם פותחים: iOS מוסר לה אותם כאסימונים אנונימיים."
          }
        }
      }
    },
    "applications_limite": {
      "comment": "Chaîne propre à iOS, choix des applications de la barrière (ApplicationsModele ; PORTAGE.md § 2.1.3, § 3.7) : à relire par le propriétaire. Exactement 50 applications (%1$lld vaut 50).",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "You have reached %1$lld apps, the most iOS can block at once. To hold back more, choose a whole category instead: it has no such limit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous avez atteint %1$lld applications, le plus qu’iOS sait bloquer à la fois. Pour en retenir davantage, choisissez plutôt une catégorie entière, qui n’a pas cette limite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הגעתם ל־%1$lld אפליקציות, המספר הגבוה ביותר ש־iOS יכול לחסום בבת אחת. כדי לחסום עוד, בחרו במקום זאת קטגוריה שלמה, שאין לה מגבלה כזו."
          }
        }
      }
    },
    "applications_ouvrir_reglages": {
      "comment": "Chaîne propre à iOS, choix des applications de la barrière (ApplicationsModele ; PORTAGE.md § 2.1.3, § 3.7) : à relire par le propriétaire. Bouton : les Réglages d’iOS, après un refus.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Open Settings"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ouvrir les Réglages"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "פתיחת ההגדרות"
          }
        }
      }
    },
    "applications_reessayer": {
      "comment": "Chaîne propre à iOS, choix des applications de la barrière (ApplicationsModele ; PORTAGE.md § 2.1.3, § 3.7) : à relire par le propriétaire. Bouton : reposer la question après un échec.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Try again"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Réessayer"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לנסות שוב"
          }
        }
      }
    },
    "applications_selection_titre": {
      "comment": "Chaîne propre à iOS, choix des applications de la barrière (ApplicationsModele ; PORTAGE.md § 2.1.3, § 3.7) : à relire par le propriétaire. Titre de la carte de la sélection.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Your selection"
          }
        },
