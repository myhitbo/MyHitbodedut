{
  "sourceLanguage": "fr",
  "strings": {
    "action_ok": {
      "comment": "« OK » d'une saisie (android.R.string.ok, une chaîne du système sur Android). Écrans d'iOS, phase 3 : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "OK"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "OK"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "אישור"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aceptar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "باهي"
          }
        }
      }
    },
    "bouclier_autre_reponse": {
      "comment": "Barrière, état propre à iOS (PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autre réponse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Other answer"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "תשובה אחרת"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otra respuesta"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "جواب آخر"
          }
        }
      }
    },
    "bouclier_notification_commencer": {
      "comment": "Barrière, état propre à iOS (PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Touchez pour commencer votre hitbodedout"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tap to start your hitbodedut"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "געו כדי להתחיל את ההתבודדות"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toca para empezar tu hitbodedut"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انقر باش تبدا الهتبوديدوت متاعك"
          }
        }
      }
    },
    "contenu_illisible": {
      "comment": "Un texte des contenus exportés qui n'a pu être lu. Écrans d'iOS, phase 3 : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce texte n'a pas pu être lu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This text could not be read."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לא ניתן היה לקרוא את הטקסט."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo leer este texto."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ما نجمناش نقراو النص هذا."
          }
        }
      }
    },
    "gate_mismatch_detail": {
      "comment": "Barrière, état propre à iOS (PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le bouclier ne suivait pas la règle du moment. L’app l’a remis d’accord et l’a noté au journal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The shield was not following the current rule. The app has put it right and noted it in the log."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "המגן לא פעל לפי הכלל הנוכחי. האפליקציה תיקנה אותו ורשמה זאת ביומן."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El escudo no seguía la regla del momento. La app lo ha corregido y lo ha anotado en el registro."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الدرع ما كانش يتبّع القاعدة متاع الوقت هذا. التطبيق صلّحو وكتبها في السجل."
          }
        }
      }
    },
    "gate_mismatch_title": {
      "comment": "Barrière, état propre à iOS (PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bouclier désaccordé"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Shield out of step"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "המגן אינו מתואם"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escudo desajustado"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الدرع موش متوافق"
          }
        }
      }
    },
    "gate_monitor_missing_detail": {
      "comment": "Barrière, état propre à iOS (PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les heures du mode ne sont plus inscrites auprès d’iOS. L’app les inscrit de nouveau ; si ce message reste, éteignez puis rallumez le mode."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The mode’s hours are no longer registered with iOS. The app registers them again; if this message stays, switch the mode off and on."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "שעות המצב אינן רשומות עוד ב־iOS. האפליקציה רושמת אותן מחדש; אם ההודעה נשארת, כבו והדליקו את המצב."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los horarios del modo ya no están registrados en iOS. La app los registra de nuevo; si este mensaje sigue, apaga y vuelve a encender el modo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "أوقات الوضع ما عادش مسجّلة عند iOS. التطبيق يسجّلها من جديد؛ كان الرسالة هذي تقعد، طفّي الوضع وعاود شعّلو."
          }
        }
      }
    },
    "gate_monitor_missing_title": {
      "comment": "Barrière, état propre à iOS (PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Surveillance absente"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schedule missing"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "המעקב חסר"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vigilancia ausente"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المراقبة غايبة"
          }
        }
      }
    },
    "gate_monitor_silent_detail": {
      "comment": "Barrière, état propre à iOS (PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS n’a pas réveillé la surveillance depuis hier. Ouvrir l’app le matin la relance."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS has not woken the schedule since yesterday. Opening the app in the morning restarts it."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS לא העירה את המעקב מאתמול. פתיחת האפליקציה בבוקר מפעילה אותו מחדש."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS no ha despertado la vigilancia desde ayer. Abrir la app por la mañana la reactiva."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS ما فيّقش المراقبة من البارح. حلّ التطبيق في الصباح يعاود يشعّلها."
          }
        }
      }
    },
    "gate_monitor_silent_title": {
      "comment": "Barrière, état propre à iOS (PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Surveillance muette"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schedule silent"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "המעקב שותק"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vigilancia en silencio"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "المراقبة ساكتة"
          }
        }
      }
    },
    "gate_reselect_detail": {
      "comment": "Barrière, état propre à iOS (PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les applications choisies ne sont plus reconnues sur cet iPhone. Choisissez-les de nouveau."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The chosen apps are no longer recognised on this iPhone. Choose them again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "האפליקציות שנבחרו אינן מזוהות עוד במכשיר הזה. בחרו אותן מחדש."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las aplicaciones elegidas ya no se reconocen en este iPhone. Elígelas de nuevo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "التطبيقات اللي اخترتها ما عادش معروفة على الآيفون هذا. اختارها من جديد."
          }
        }
      }
    },
    "gate_reselect_title": {
      "comment": "Barrière, état propre à iOS (PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sélection à refaire"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choose the apps again"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "יש לבחור מחדש"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hay que volver a elegir"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لازم تعاود تختار"
          }
        }
      }
    },
    "gate_revoked_detail": {
      "comment": "Barrière, état propre à iOS (PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS a retiré l’accès à Temps d’écran : plus rien n’est retenu. Le rendre ?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS removed Screen Time access: nothing is held back any more. Give it back?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS הסירה את הגישה לזמן מסך: דבר כבר לא מעוכב. להחזיר אותה?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS retiró el acceso a Tiempo de uso: ya no se retiene nada. ¿Devolverlo?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS نحّى النفاذ لمدة استخدام الشاشة: ما عاد شي يتسكّر. ترجّعو؟"
          }
        }
      }
    },
    "gate_revoked_title": {
      "comment": "Barrière, état propre à iOS (PORTAGE.md § 2.1.4, § 2.1.8) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Accès retiré par iOS"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Access removed by iOS"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "הגישה הוסרה על ידי iOS"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Acceso retirado por iOS"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "النفاذ تنحّى من iOS"
          }
        }
      }
    },
    "ios_bientot": {
      "comment": "Propre à iOS (PORTAGE.md § 4.2), à relire par le propriétaire : sous le titre d'un onglet dont l'écran n'est pas encore porté.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bientôt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coming soon"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "בקרוב"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Próximamente"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قريب"
          }
        }
      }
    },
    "ios_icone_couleurs": {
      "comment": "Réglages, apparence : changer l'icône de l'app sur un geste, iOS prévenant à chaque changement (PORTAGE.md § 2.3). Écrans d'iOS, phase 3 : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mettre l'icône aux couleurs choisies"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Match the app icon to your colours"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "להתאים את סמל היישום לצבעים שנבחרו"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poner el icono con los colores elegidos"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "خلّي الأيقونة بالألوان اللي اخترتهم"
          }
        }
      }
    },
    "ios_vol_billet_fichier": {
      "comment": "Écran du vol (VolVue), billet : choisir un fichier, PDF ou image, dans Fichiers (le sélecteur d'Android). À relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisir un fichier (PDF ou image)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choose a file (PDF or image)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "בחירת קובץ (PDF או תמונה)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elegir un archivo (PDF o imagen)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختار ملف (PDF ولّا تصويرة)"
          }
        }
      }
    },
    "ios_vol_billet_photo": {
      "comment": "Écran du vol (VolVue), billet : choisir une photo dans la photothèque (PhotosPicker). À relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choisir une photo du billet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Choose a photo of the ticket"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "בחירת תמונה של הכרטיס"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elegir una foto del boleto"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختار تصويرة متاع التذكرة"
          }
        }
      }
    },
    "ios_vol_billet_scanner": {
      "comment": "Écran du vol (VolVue), billet : lire la carte d'embarquement avec l'appareil photo (VisionKit, propre à iOS ; Android n'importe que le fichier). À relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scanner la carte d’embarquement"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scan the boarding pass"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "סריקת כרטיס העלייה למטוס"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escanear el pase de abordar"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اقرا بطاقة الصعود بالكاميرا"
          }
        }
      }
    },
    "ios_vol_billet_viser": {
      "comment": "Écran du vol, lecture du billet par l'appareil photo : la consigne au-dessus de l'image. À relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Visez le code-barres de la carte d’embarquement."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Point the camera at the boarding pass barcode."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "כוונו את המצלמה אל הברקוד של כרטיס העלייה למטוס."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apunta la cámara al código de barras del pase de abordar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "وجّه الكاميرا للكود-بار متاع بطاقة الصعود."
          }
        }
      }
    },
    "reglages_autorisation_temps_ecran": {
      "comment": "Réglages, carte des autorisations : Family Controls (PORTAGE.md § 2.1). Écrans d'iOS, phase 3 : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Temps d'écran"
