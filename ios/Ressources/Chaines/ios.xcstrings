    "contenu_illisible": {
      "comment": "Un texte des contenus exportés qui n'a pu être lu. Écrans d'iOS, phase 3 : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce texte n'a pas pu être lu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This text could not be read."
          }
        },
