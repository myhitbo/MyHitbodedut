    "reglages_divulgation_texte": {
      "comment": "Chaîne propre à iOS, lue par le Traducteur de l'app (App/MyHitbodedutApp.swift fusionne ce catalogue au sien) : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MyHitbodedut uses Screen Time to keep the apps you choose closed in the morning until your hitbodedut. The app does not see what you open; nothing leaves the phone. You can turn the mode off at any time in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MyHitbodedut utilise Temps d’écran pour garder fermées, le matin, les applications que vous choisissez, jusqu’à votre hitbodedout. L’application ne voit pas ce que vous ouvrez ; rien ne quitte le téléphone. Vous pouvez couper le mode à tout moment dans les Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MyHitbodedut משתמשת בזמן מסך כדי להשאיר סגורות בבוקר את האפליקציות שבחרת, עד ההתבודדות שלך. האפליקציה אינה רואה מה אתה פותח; דבר אינו יוצא מהטלפון. אפשר לכבות את המצב בכל עת בהגדרות."
          }
        }
      }
    },
