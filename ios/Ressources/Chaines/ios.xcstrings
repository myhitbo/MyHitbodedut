    "lecture_marque_basculer": {
      "comment": "Chaîne propre à iOS, lue par le Traducteur de l'app (App/MyHitbodedutApp.swift fusionne ce catalogue au sien) : à relire par le propriétaire. Action VoiceOver qui remplace l'appui long sur un paragraphe ou un verset.",
      "extractionState": "manual",
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Poser ou retirer un marque-page"
