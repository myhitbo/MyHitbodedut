            "state": "needs_review",
            "value": "Screen Time"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "זמן מסך"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiempo de uso"
          }
        },
        "ar": {
