{
  "sourceLanguage": "en",
  "strings": {
    "NSLocationWhenInUseUsageDescription": {
      "comment": "La raison de la localisation (ChoixLieu.kt, VolActivity.releverGps). Écrans d'iOS, phase 3 : à relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "ar-TN": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بلاصتك تستعمل كان للزمنيم، لاتجاه القدس، وفي الطيارة للأوقات اللي تحت الطيارة. تبقى في التليفون."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Your location is only used for zmanim, the direction of Jerusalem and, in flight, the times below the plane. It stays on the device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Su ubicación solo sirve para los zmanim, la dirección de Jerusalén y, en vuelo, los horarios bajo el avión. Se queda en el dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Votre position ne sert qu’aux zmanim, à la direction de Jérusalem et, en vol, aux horaires sous l’avion. Elle reste sur l’appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "המיקום משמש רק לזמני היום, לכיוון ירושלים ובטיסה לזמנים שמתחת למטוס. הוא נשאר במכשיר."
          }
        }
      }
    },
    "vol": {
      "comment": "NSLocationTemporaryUsageDescriptionDictionary, clé « vol » : la précision complète demandée pour une fois au relevé GPS du vol. À relire par le propriétaire.",
      "extractionState": "manual",
      "localizations": {
        "ar-TN": {
          "stringUnit": {
            "state": "needs_review",
            "value": "البلاصة الدقيقة متاع الـGPS تصلّح طريق الطيارة والزمنيم متاع الرحلة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A precise GPS fix realigns the plane’s route and the in-flight zmanim."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La posición GPS precisa ajusta la ruta del avión y los zmanim del vuelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le relevé GPS précis recale la route de l’avion et les zmanim du vol."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מיקום GPS מדויק מתקן את מסלול המטוס ואת זמני הטיסה."
          }
        }
      }
    }
  },
  "version": "1.0"
}
