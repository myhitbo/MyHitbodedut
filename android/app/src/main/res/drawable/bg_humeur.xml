<?xml version="1.0" encoding="utf-8"?>
<!-- Une humeur de la fin de séance (13/11) : la case ordinaire, cerclée et teintée quand elle est choisie. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/mhMint" />
            <stroke android:width="2dp" android:color="?attr/mhBrand" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/mhCard" />
            <stroke android:width="1dp" android:color="?attr/mhLine" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
