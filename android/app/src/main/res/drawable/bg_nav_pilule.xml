<?xml version="1.0" encoding="utf-8"?>
<!--
    La barre d'onglets en pilule flottante (10/11, sur le modèle de
    l'application Claude) : un ruban arrondi posé au-dessus du bas de l'écran,
    sur la couleur des cartes, cerné d'un filet.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/mhCard" />
    <stroke
        android:width="1dp"
        android:color="?attr/mhLine" />
    <corners android:radius="36dp" />
</shape>
