<?xml version="1.0" encoding="utf-8"?>
<!--
    L'accueil couché (téléphone ou tablette en paysage) : la même chose que
    layout/activity_main.xml, mêmes identifiants (LayoutPaysageTest), mais
    les anneaux à côté de l'en-tête.

    L'accueil, refonte du 13/11 : trois lieux en onglets — Le Jour, Les Livres,
    Le Chemin — et une barre de départ toujours visible au-dessus d'eux.

    Le Jour garde le hassid au creux des anneaux (pistes A + D, 28/09) ; le
    bouton « Commencer » et ses pastilles l'ont quitté pour la barre et son
    volet. Zmanim et Réglages ne sont plus des onglets : la date hébraïque et
    la roue, en tête du Jour.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/mhPaper"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Le Jour -->
        <ScrollView
            android:id="@+id/main_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingHorizontal="@dimen/wide_gutter">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/edge_inner"
                android:paddingTop="4dp"
                android:paddingBottom="16dp">

                <!-- Les anneaux à part, au début de la ligne (à droite en hébreu). En haut, pas au milieu :
                     depuis la refonte du 13/11 la colonne voisine porte les cartes du moment et dépasse
                     l'écran ; centrés sur elle, les anneaux partaient sous le pli (recette du 22/11). -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top"
                    android:orientation="vertical">

                    <!-- Les trois anneaux (jour, semaine, série), et le hassid qui accueille en leur creux. -->
                    <FrameLayout
                        android:layout_width="@dimen/gauge_size_side"
                        android:layout_height="@dimen/gauge_size_side"
                        android:layout_gravity="center_horizontal">

                        <com.myhitbodedut.AnneauxView
                            android:id="@+id/week_gauge"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <!-- 34dp : trois anneaux de 8dp, deux écarts de 3dp, et un peu d'air. -->
                        <FrameLayout
                            android:id="@+id/hero_plate"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="32dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:contentDescription="@string/rings_character_hint"
                            android:background="@drawable/bg_gauge_plate"
                            android:paddingHorizontal="16dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="4dp">

                            <ImageView
                                android:id="@+id/hero_character"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@null"
                                android:scaleType="fitCenter" />

                            <!-- Les autres faces du centre : un chiffre et ce qu'il compte (Plaque). -->
                            <LinearLayout
                                android:id="@+id/hero_face"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:paddingBottom="8dp"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/hero_face_value"
                                    android:layout_width="match_parent"
                                    android:layout_height="44dp"
                                    android:autoSizeMaxTextSize="34sp"
                                    android:autoSizeMinTextSize="16sp"
                                    android:autoSizeTextType="uniform"
                                    android:fontFeatureSettings="tnum"
                                    android:gravity="center"
                                    android:maxLines="1"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/hero_face_caption"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="0dp"
                                    android:gravity="center"
                                    android:maxLines="3"
                                    android:textColor="@color/on_plate_muted"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </FrameLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/week_gauge_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:textColor="?attr/mhMuted"
                        android:textSize="16sp" />

                    <!-- Le palier le plus proche (11/10) : touché, il ouvre les trophées et paliers.
                         De la largeur des anneaux, sur plusieurs lignes : large comme son texte, il élargissait
                         cette colonne à 420 dp et n'en laissait que 150 à l'en-tête, coupé lettre par lettre
                         sur une tablette couchée (recette du 22/11). -->
                    <TextView
                        android:id="@+id/paliers_line"
                        android:layout_width="match_parent"
                        android:layout_gravity="center_horizontal"
                        android:minHeight="48dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:textColor="?attr/mhBrand"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- L'en-tête et la semaine, à côté des anneaux. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!--
                        Le Jour (13/11) : la date hébraïque ouvre « Le ciel » (zmanim, calendrier,
                        hilloulot, boussole) ; la roue ouvre les réglages. Les deux étaient des
                        onglets : ils gardent leurs identifiants.
                    -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/nav_zmanim"
                            style="@style/StartChip"
                            android:drawablePadding="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:minHeight="48dp"
                            android:textColor="?attr/mhInk"
                            android:textSize="14sp"
                            app:drawableEndCompat="@drawable/ic_chevron"
                            app:drawableStartCompat="@drawable/ic_ciel" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/nav_settings"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/settings_title"
                            android:src="@drawable/ic_nav_settings_off" />
                    </LinearLayout>


                    <TextView
                        android:id="@+id/hero_greeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="?attr/mhInk"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Sans prénom, cette ligne devient le titre (MainActivity.renderGreeting).
                         Les lignes d'état sont en Varela Round (demande du 10/10, OFL :
                         assets/licences/OFL-VarelaRound.txt), le titre garde la police système. -->
                    <TextView
                        android:id="@+id/status_title"
                        android:fontFamily="@font/varela_round"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/mhMuted"
                        android:textSize="17sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/status_streak"
                            android:fontFamily="@font/varela_round"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textColor="?attr/mhMuted"
                            android:textSize="17sp" />

                        <!-- Le point qui sépare la série du total ; masqué avec le total. -->
                        <TextView
                            android:id="@+id/status_separator"
                            android:fontFamily="@font/varela_round"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:text="@string/status_separator"
                            android:textColor="?attr/mhMuted"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/status_total"
                            android:fontFamily="@font/varela_round"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFeatureSettings="tnum"
                            android:layout_weight="1"
                                                        android:maxLines="2"
                            android:textColor="?attr/mhMuted"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/today_detail"
                        android:fontFamily="@font/varela_round"
                        style="@style/CardHint"
                        android:textSize="16sp"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/mhBrand"
                        android:visibility="gone" />


                    <LinearLayout
                        android:id="@+id/week_strip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal" />

                    <!-- Le moment « relance », après une rupture de série. -->
                    <include
                        android:id="@+id/relance_chizuk"
                        layout="@layout/view_chizuk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp" />

                    <Button
                        android:id="@+id/today_note"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/action_write_note"
                        android:visibility="gone" />

                    <!-- L'écran de préparation (FPRODUIT-04) : « Sans durée » et « Commencer simplement » y vivent, le bouton principal démarre d'un toucher. -->
                    <Button
                        android:id="@+id/start_prepare"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/start_prepare" />

                    <!--
                        Une hitbodedout faite loin du téléphone, comme le conseil
                        n° 4 y invite : elle compte aussi (revue du 29/09).
                    -->
                    <Button
                        android:id="@+id/today_offline"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/action_done_offline"
                        android:visibility="gone" />

                    <!-- Selon l'heure (14/10) : la prière du moment, Birkat haLevana les soirs de la fenêtre. -->
                    <LinearLayout
                        android:id="@+id/accueil_moment"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!--
            Les Livres (13/11) : trois rayons classés par geste — prier, étudier,
            se renforcer — au lieu d'une liste. Aucune section n'est retirée ; la
            musique et les rappels ont rejoint le volet de la séance.
        -->
        <ScrollView
            android:id="@+id/texts_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingHorizontal="@dimen/wide_gutter"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/edge_inner"
                    android:paddingTop="16dp"
                    android:text="@string/nav_texts"
                    android:textColor="?attr/mhInk"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- La recherche dans toute l'application (14/10). -->
                <Button
                    android:id="@+id/recherche_button"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/edge_inner"
                    android:layout_marginTop="12dp"
                    android:gravity="start|center_vertical"
                    android:text="@string/recherche_indice" />

                <!-- Reprendre la lecture là où on s'est arrêté, et les favoris (14/10). -->
                <LinearLayout
                    android:id="@+id/reprise_favoris"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Premier rayon : prier. -->
                <TextView
                    style="@style/RayonTitre"
                    android:text="@string/rayon_prier" />

                <LinearLayout style="@style/Rayon">

                    <!-- Le siddour : les prières du jour et les bénédictions (04/10). -->
                    <LinearLayout
                        android:id="@+id/siddur_button"
                        style="@style/Couverture"
                        android:background="@drawable/couv_vert">

                        <TextView style="@style/CouvertureTitre" android:text="@string/couv_siddur" />

                        <TextView style="@style/CouvertureLibelle" android:text="@string/siddur_title" />
                    </LinearLayout>

                    <!-- Le livre entier, et la part du jour (04/10). -->
                    <LinearLayout
                        android:id="@+id/tehilim_button"
                        style="@style/Couverture"
                        android:background="@drawable/couv_bleu">

                        <TextView style="@style/CouvertureTitre" android:text="@string/couv_tehilim" />

                        <TextView style="@style/CouvertureLibelle" android:text="@string/tehilim_title" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tikkun_button"
                        style="@style/Couverture"
                        android:background="@drawable/couv_clair">

                        <TextView style="@style/CouvertureTitre.Clair" android:text="@string/couv_tikkun" />

                        <TextView style="@style/CouvertureLibelle.Clair" android:text="@string/tikkun_title" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tefilot_button"
                        style="@style/Couverture"
                        android:layout_marginEnd="0dp"
                        android:background="@drawable/couv_violet">

                        <TextView style="@style/CouvertureTitre" android:text="@string/couv_tefilot" />

                        <TextView style="@style/CouvertureLibelle" android:text="@string/tefilot_title" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/Etagere" />

                <!-- Où en sont le Tikoun et les Tehilim du jour, sans ouvrir le livre. -->
                <TextView
                    android:id="@+id/tikkun_state"
                    style="@style/SectionState"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="@dimen/edge_inner" />

                <TextView
                    android:id="@+id/tehilim_state"
                    style="@style/SectionState"
                    android:paddingHorizontal="@dimen/edge_inner" />

                <!-- Deuxième rayon : étudier. -->
                <TextView
                    style="@style/RayonTitre"
                    android:text="@string/rayon_etudier" />

                <LinearLayout style="@style/Rayon">

                    <LinearLayout
                        android:id="@+id/library_button"
                        style="@style/Couverture"
                        android:background="@drawable/couv_brun">

                        <TextView style="@style/CouvertureTitre" android:text="@string/couv_sources" />

                        <TextView style="@style/CouvertureLibelle" android:text="@string/library_title" />
                    </LinearLayout>

                    <!-- Les livres entiers : Likoutei Moharan, les méguilot … (13/10). -->
                    <LinearLayout
                        android:id="@+id/livres_button"
                        style="@style/Couverture"
                        android:background="@drawable/couv_parchemin">

                        <TextView style="@style/CouvertureTitre.Clair" android:text="@string/couv_livres" />

                        <TextView style="@style/CouvertureLibelle.Clair" android:text="@string/livres_title" />
                    </LinearLayout>

                    <!-- La halakha du jour : elle n'était atteinte que depuis les zmanim. -->
                    <LinearLayout
                        android:id="@+id/halakha_button"
                        style="@style/Couverture"
                        android:background="@drawable/couv_petrole">

                        <TextView style="@style/CouvertureTitre" android:text="@string/couv_halakha" />

                        <TextView style="@style/CouvertureLibelle" android:text="@string/halakha_title" />
                    </LinearLayout>

                    <Space style="@style/Couverture" android:layout_marginEnd="0dp" />
                </LinearLayout>

                <View style="@style/Etagere" />

                <!-- Troisième rayon : se renforcer. -->
                <TextView
                    style="@style/RayonTitre"
                    android:text="@string/rayon_renforcer" />

                <LinearLayout style="@style/Rayon">

                    <LinearLayout
                        android:id="@+id/chizuk_button"
                        style="@style/Couverture"
                        android:background="@drawable/couv_menthe">

                        <TextView style="@style/CouvertureTitre.Clair" android:text="@string/couv_chizuk" />

                        <TextView style="@style/CouvertureLibelle.Clair" android:text="@string/chizuk_demande_title" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tips_button"
                        style="@style/Couverture"
                        android:background="@drawable/couv_vert">

                        <TextView style="@style/CouvertureTitre" android:text="@string/couv_conseils" />

                        <TextView style="@style/CouvertureLibelle" android:text="@string/tips_title" />
                    </LinearLayout>

                    <Space style="@style/Couverture" />

                    <Space style="@style/Couverture" android:layout_marginEnd="0dp" />
                </LinearLayout>

                <View style="@style/Etagere" />

                <!-- L'écran de relecture, en édition de test seulement (MainActivity). -->
                <LinearLayout
                    android:id="@+id/proofread_button"
                    style="@style/SectionRow"
                    android:layout_marginHorizontal="@dimen/edge_inner"
                    android:layout_marginTop="8dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingLabelStacked"
                            android:text="@string/proofread_open" />
                    </LinearLayout>

                    <ImageView style="@style/SectionChevron" android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!--
            Le Chemin (13/11) : ce qui a été fait. Les chiffres et le mois en cours,
            puis le journal, le parcours et les trophées, qui étaient dispersés entre
            un onglet et le bas de l'accueil.
        -->
        <ScrollView
            android:id="@+id/chemin_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:paddingHorizontal="@dimen/wide_gutter"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/edge_inner"
                    android:paddingTop="16dp"
                    android:text="@string/nav_chemin"
                    android:textColor="?attr/mhInk"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout style="@style/Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/CheminChiffre">

                            <TextView android:id="@+id/chemin_serie" style="@style/CheminValeur" />

                            <TextView style="@style/CheminLegende" android:text="@string/chemin_stat_serie" />
                        </LinearLayout>

                        <LinearLayout style="@style/CheminChiffre">

                            <TextView android:id="@+id/chemin_meilleure" style="@style/CheminValeur" />

                            <TextView style="@style/CheminLegende" android:text="@string/chemin_stat_meilleure" />
                        </LinearLayout>

                        <LinearLayout style="@style/CheminChiffre">

                            <TextView android:id="@+id/chemin_total" style="@style/CheminValeur" />

                            <TextView style="@style/CheminLegende" android:text="@string/chemin_stat_total" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Les minutes de chaque jour du mois, comme en tête du journal (MainActivity.renderChemin). -->
                    <LinearLayout
                        android:id="@+id/chemin_mois"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout style="@style/Card">

                    <LinearLayout
                        android:id="@+id/journal_button"
                        style="@style/SectionRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingLabelStacked"
                                android:text="@string/nav_journal" />

                            <TextView
                                android:id="@+id/journal_state"
                                style="@style/SectionState" />
                        </LinearLayout>

                        <ImageView style="@style/SectionChevron" android:importantForAccessibility="no" />
                    </LinearLayout>

                    <!-- « Mon parcours » (19/10) et les trophées (11/10), qui étaient en bas de l'accueil. -->
                    <LinearLayout
                        android:id="@+id/parcours_button"
                        style="@style/SectionRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingLabelStacked"
                                android:text="@string/parcours_title" />

                            <TextView
                                style="@style/SectionState"
                                android:text="@string/chemin_parcours_hint" />
                        </LinearLayout>

                        <ImageView style="@style/SectionChevron" android:importantForAccessibility="no" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/trophees_paliers"
                        style="@style/SectionRow">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/SettingLabelStacked"
                                android:text="@string/chemin_trophees" />

                            <TextView
                                android:id="@+id/trophees_state"
                                style="@style/SectionState" />
                        </LinearLayout>

                        <ImageView style="@style/SectionChevron" android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!--
            Le volet de la séance (13/11) : ce avec quoi on y entre. Il monte
            au-dessus de la barre de départ quand on touche sa flèche ; le voile
            derrière lui le referme. Rien n'y est obligatoire.
        -->
        <View
            android:id="@+id/depart_voile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/voile"
            android:contentDescription="@string/depart_fermer"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/depart_volet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_volet"
            android:clickable="true"
            android:elevation="12dp"
            android:paddingHorizontal="@dimen/wide_gutter"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/edge_inner"
                android:paddingTop="10dp"
                android:paddingBottom="8dp">

                <View
                    android:layout_width="40dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/bg_volet_poignee" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/depart_titre"
                    android:textColor="?attr/mhInk"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/start_duration"
                    style="@style/StartRow">

                    <TextView style="@style/StartLabel.Volet" android:text="@string/start_duration" />

                    <TextView android:id="@+id/start_duration_value" style="@style/StartValue" />

                    <ImageView style="@style/SectionChevron" android:importantForAccessibility="no" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/start_theme"
                    style="@style/StartRow">

                    <TextView style="@style/StartLabel.Volet" android:text="@string/start_theme" />

                    <TextView android:id="@+id/start_theme_value" style="@style/StartValue" />

                    <ImageView style="@style/SectionChevron" android:importantForAccessibility="no" />
                </LinearLayout>

                <!-- La musique : son état, son interrupteur, et la bibliothèque des niggounim derrière la ligne. -->
                <LinearLayout
                    android:id="@+id/music_button"
                    style="@style/SectionRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/StartLabel.Volet"
                            android:text="@string/music_title" />

                        <TextView
                            android:id="@+id/music_state"
                            style="@style/SectionState" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/music_switch_main"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <ImageView style="@style/SectionChevron" android:importantForAccessibility="no" />
                </LinearLayout>

                <!-- La barrière du matin : retirée en édition légère (MainActivity.renderStartCard). -->
                <LinearLayout
                    android:id="@+id/start_focus"
                    style="@style/StartRow">

                    <TextView style="@style/StartLabel.Volet" android:text="@string/start_focus" />

                    <TextView android:id="@+id/start_focus_value" style="@style/StartValue" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/reminders_button"
                    style="@style/SectionRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/StartLabel.Volet"
                            android:text="@string/reminders_title" />

                        <TextView
                            android:id="@+id/reminders_state"
                            style="@style/SectionState" />
                    </LinearLayout>

                    <ImageView style="@style/SectionChevron" android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!--
        La barre de départ (13/11) : visible dans les trois lieux. Le bouton
        commence la séance ; la flèche ouvre le volet de ses réglages.
    -->
    <FrameLayout
        android:id="@+id/depart_barre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/mhPaper"
        android:paddingHorizontal="@dimen/edge"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/start_session"
            style="@style/StartButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="64dp"
            android:textSize="17sp" />

        <ImageButton
            android:id="@+id/depart_regler"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/depart_regler"
            android:elevation="8dp"
            android:outlineProvider="none"
            android:src="@drawable/ic_chevron_haut"
            app:tint="?attr/colorOnPrimary" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/mhCard"
        app:itemActiveIndicatorStyle="@style/NavIndicator"
        app:itemTextAppearanceActive="@style/NavLabel"
        app:itemTextAppearanceInactive="@style/NavLabel"
        app:itemIconTint="@color/nav_item"
        app:itemTextColor="@color/nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/nav_main" />
</LinearLayout>
