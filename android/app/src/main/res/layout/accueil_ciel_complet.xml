<?xml version="1.0" encoding="utf-8"?>
<!--
    L'accueil « Ciel complet » (refonte D aimée, 15/11) : le ciel réel du lieu prend
    tout l'écran. Le soleil suit son arc entre lever et coucher, la nuit allume les
    étoiles ; l'heure, le moment du jour et le prochain zman en haut, la séance posée
    sur la colline dans une carte de verre. La hauteur est celle de l'écran, donnée
    par MainActivity ; les couleurs du texte suivent la clarté du ciel.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ciel_complet"
    android:layout_width="match_parent"
    android:layout_height="640dp"
    android:visibility="gone"
    tools:visibility="visible">

    <com.myhitbodedut.CielView
        android:id="@+id/ciel_complet_fond"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:contentDescription="@string/ciel_description"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/ciel_complet_entete"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp">

        <TextView
            android:id="@+id/ciel_complet_lieu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.88"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/ciel_complet_heure"
            style="?attr/mhStyleTitre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:textSize="64sp" />

        <TextView
            android:id="@+id/ciel_complet_moment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ciel_complet_prochain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.88"
            android:maxLines="2"
            android:ellipsize="end"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ciel_complet_verre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ciel_complet_etat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ciel_complet_serie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:alpha="0.85"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ciel_complet_conseil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.9"
            android:lineSpacingMultiplier="1.15"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ciel_complet_commencer"
            style="@style/StartButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</FrameLayout>
